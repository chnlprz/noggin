{
  // Cloudflare Worker: static assets from dist/ plus a small API under /api (Phase 6: passkeys, sync; Phase 7: Nudge! handoff).
  // Served at noggin.innovaspace.app (custom domain).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noggin",
  "main": "worker/index.ts",
  "workers_dev": true,
  "routes": [{ "pattern": "noggin.innovaspace.app", "custom_domain": true }],
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
