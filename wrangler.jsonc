{
  // Cloudflare Worker: static assets from dist/ plus a small API under /api (Phase 6: passkeys, sync; Phase 7: Nudge! handoff).
  // Served at noggin.innovaspace.app (custom domain).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noggin",
  "main": "worker/index.ts",
  "workers_dev": true,
  "routes": [{ "pattern": "noggin.innovaspace.app", "custom_domain": true }],
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Shared Innova Space accounts live in Nudge!'s D1 database; Noggin? keeps its rows in its own tables there.
  "d1_databases": [
    { "binding": "DB", "database_name": "nudge", "database_id": "2a303c20-837b-41ca-a7d1-c759772d1aa4" }
  ],
  // Feedback copies go to the Innova Space inbox (a verified destination in Email Routing for innovaspace.app).
  "send_email": [{ "name": "FEEDBACK_MAIL", "destination_address": "hello.innovaspace@gmail.com" }],
  "vars": { "RP_ID": "innovaspace.app", "FEEDBACK_FROM": "noggin@innovaspace.app", "FEEDBACK_TO": "hello.innovaspace@gmail.com" }
}
